generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Course {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  programSlug String       @default("mscdabe")
  description String?
  courseUrl   String?
  isActive    Boolean      @default(true)
  academicYears AcademicYear[]
  assessments  Assessment[]
  notes        Note[]
  courseFiles  CourseFile[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model AcademicYear {
  id          String       @id @default(cuid())
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  yearLabel   String
  semester    String
  assessments Assessment[]

  @@unique([courseId, yearLabel, semester])
}

model Assessment {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type           String
  totalPoints    Float        @default(100)
  studentCount   Int
  meanScore      Float
  medianScore    Float
  maxScore       Float        @default(0)
  minScore       Float        @default(0)
  gradeEntries   GradeEntry[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([academicYearId, type])
}

model GradeEntry {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  surname      String
  firstName    String
  totalScore   Float
  subScores    Json
  comments     String?
  specialIssue String?
}

model Note {
  id             String   @id @default(cuid())
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assessmentType String
  academicYear   String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([courseId, assessmentType, academicYear])
}

model CourseFile {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name         String
  type         String
  academicYear String
  semester     String
  fileKind     String   @default("Other")
  fileUrl      String
  fileSize     Int
  createdAt    DateTime @default(now())
}

model TAManpower {
  id           String   @id @default(cuid())
  title        String
  academicYear String
  semester     String
  fileUrl      String
  fileSize     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([academicYear, semester])
}

model WeeklyHour {
  id           String   @id @default(cuid())
  academicYear String
  semester     String
  hours        Float
  updatedAt    DateTime @updatedAt

  @@unique([academicYear, semester])
}
